<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="impakt_maui_app.MainPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="{Binding Name}"
                   Style="{StaticResource Headline}" />

            <Label Text="{Binding SurName}"
                   Style="{StaticResource Headline}" />

            <Button x:Name="ButtonAddMember"
                    Text="Add new member"
                    Clicked="OnAddMemberClicked"/>

            <Button x:Name="ButtonQRScanner"
                    Text="Go to QRScanner" 
                    Clicked="OnTempClicked" />

            <Button x:Name="ButtonCheckInHistory"
                    Text="Go to CheckIn history"
                    Clicked="OnCheckInHistoryClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
