<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="impakt_maui_app.LoginPage">

    <VerticalStackLayout Padding="30" Spacing="20">
        <Label Text="Login" FontSize="32" HorizontalOptions="Center" />

        <Entry x:Name="UsernameEntry" Placeholder="Username" 
               Focused="EntryFormsFocused" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True"
               Focused="EntryFormsFocused" />

        <Button x:Name="ButtonLogin"
                Text="Login" 
                Clicked="OnLoginClicked" />

        <!--Example of conditional view depends on platform-->
        <Entry x:Name="IpEntry" Placeholder="Connection IP" />
        <!--<Entry x:Name="IpEntry" Placeholder="Connection IP">
            <Entry.IsVisible>
                <OnPlatform x:TypeArguments="x:Boolean">
                    <On Platform="Android" Value="True"/>
                </OnPlatform>
            </Entry.IsVisible>
        </Entry>-->
        
    </VerticalStackLayout>

</ContentPage>