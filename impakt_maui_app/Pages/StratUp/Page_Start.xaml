<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="impakt_maui_app.Pages.Page_Start"
             BackgroundColor="{StaticResource PrimeWhite}">

    <VerticalStackLayout Padding="36,80,36,36"
                         VerticalOptions="Start">
        
        <!--Add logo later-->
        <!--<Image Source="logo.png"
               HeightRequest="100"
               HorizontalOptions="Center"/>-->

        <Button Text="Log In"
                BackgroundColor="{StaticResource PrimeOrange}"
                Style="{StaticResource PrimeButton}"
                Clicked="BTN_LogIn_Clicked"/>

        <Button Text="Sign Up"
                Style="{StaticResource AlternateButton}"
                Clicked="BTN_SignUp_Clicked" />

        <Label Text="Forgot Password?"
               HorizontalOptions="Center"
               FontSize="12"
               TextDecorations="Underline">
            
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="LB_ForgotPassword_Tapped" />
            </Label.GestureRecognizers>
        </Label>

    </VerticalStackLayout>
</ContentPage>