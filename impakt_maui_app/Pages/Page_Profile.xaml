<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:impakt_maui_app"
             x:Class="impakt_maui_app.Pages.Page_Profile"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Profile"
                   FontSize="32"
                   HorizontalOptions="Center" />

            <!-- Profile Image -->
            <Border StrokeThickness="0"
                    BackgroundColor="LightGray"
                    WidthRequest="120"
                    HeightRequest="120"
                    StrokeShape="RoundRectangle 60"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Image Source="profile_placeholder.png"
                       Aspect="AspectFill"
                       WidthRequest="120"
                       HeightRequest="120"/>
            </Border>

            <!-- Name and Email
                To be updated firstly -->
            <!--<Label Text="{x:Static local:User.Account}"/>
            <Label Text="{x:Static local:User.Account.Name}" FontSize="24" HorizontalOptions="Center"/>
            <Label Text="{x:Static local:User.Account.SurName}" FontSize="24" HorizontalOptions="Center"/>
            <Label Text="{x:Static local:User.Account.Email}" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>-->

            <!-- Bio 
                Can be used as an introduction to every instructor later. -->
            <!--<Label Text="Bio" FontAttributes="Bold" />
            <Label Text="Just another tech enthusiast exploring mobile development." 
                   LineBreakMode="WordWrap"/>-->

            <!-- Buttons [TBD] -->
            <Button Text="Edit Profile" 
                    CornerRadius="10" BackgroundColor="#007AFF" TextColor="White"/>
            
            
            <Button Text="Add member" 
                    CornerRadius="10" BackgroundColor="#007AFF" TextColor="White"
                    Clicked="Btn_OnAddMemberClicked"/>

            <!--Passes management-->
            <Button Text="External payment providers" 
                    CornerRadius="10" BackgroundColor="#007AFF" TextColor="White"
                    Clicked="Btn_OnExternalProvidersClicked"/>
            <Button Text="Pass types" 
                    CornerRadius="10" BackgroundColor="#007AFF" TextColor="White"
                    Clicked="Btn_OnPassTypesClicked"/>

            <Button Text="Log Out" 
                    CornerRadius="10" BackgroundColor="#007AFF" TextColor="White"
                    Clicked="Btn_OnLogOutClicked"/>

            <Button Text="Show QR Code"
                    Clicked="Btn_OnShowQrCodeClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
