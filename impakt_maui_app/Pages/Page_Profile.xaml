<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="impakt_maui_app.Pages.Page_Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Profile"
                   FontSize="32"
                   HorizontalOptions="Center" />

            <!-- Profile Image -->
            <Border StrokeThickness="0"
                    BackgroundColor="LightGray"
                    WidthRequest="120"
                    HeightRequest="120"
                    StrokeShape="RoundRectangle 60"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Image Source="profile_placeholder.png"
                       Aspect="AspectFill"
                       WidthRequest="120"
                       HeightRequest="120"/>
            </Border>

            <!-- Name and Email -->
            <Label Text="John Doe" FontSize="24" HorizontalOptions="Center"/>
            <Label Text="johndoe@email.com" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>

            <!-- Stats -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="Posts" FontAttributes="Bold" />
                    <Label Text="50" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Followers" FontAttributes="Bold" />
                    <Label Text="1090" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="Following" FontAttributes="Bold" />
                    <Label Text="150" />
                </VerticalStackLayout>
            </Grid>

            <!-- Bio -->
            <Label Text="Bio" FontAttributes="Bold" />
            <Label Text="Just another tech enthusiast exploring mobile development." 
                   LineBreakMode="WordWrap"/>

            <!-- Buttons -->
            <Button Text="Edit Profile" CornerRadius="10" BackgroundColor="#007AFF" TextColor="White"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
