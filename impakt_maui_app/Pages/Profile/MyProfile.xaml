<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            xmlns:local="clr-namespace:impakt_maui_app"
            x:Class="impakt_maui_app.Pages.Profile.MyProfile"
            Background="{StaticResource PrimeWhite}"
            Title="MyProfile">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PrimeVerticalStack}">

            <!-- Header -->
            <Label Text="Profile"
                    FontSize="32"
                    HorizontalOptions="Center" />

            <!-- Profile Image -->
            <Border StrokeThickness="0"
                    BackgroundColor="LightGray"
                    WidthRequest="120"
                    HeightRequest="120"
                    StrokeShape="RoundRectangle 60"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Image Source="profile_placeholder.png"
                        Aspect="AspectFill"
                        WidthRequest="120"
                        HeightRequest="120"/>
            </Border>

            <!-- Name and Email
                To be updated firstly -->
            <!--<Label Text="{x:Static local:User.Account}"/>
            <Label Text="{x:Static local:User.Account.Name}" FontSize="24" HorizontalOptions="Center"/>
            <Label Text="{x:Static local:User.Account.SurName}" FontSize="24" HorizontalOptions="Center"/>
            <Label Text="{x:Static local:User.Account.Email}" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>-->

            <!-- Buttons [TBD] -->
            <Button Text="Edit Profile" 
                    Style="{StaticResource PrimeButton}" 
                    IsEnabled="False"/>

            <!--Passes management-->
            <Button Text="External payment providers" 
                    Style="{StaticResource PrimeButton}"
                    Clicked="Btn_OnExternalProvidersClicked"/>
            <Button Text="Pass types" 
                    Style="{StaticResource PrimeButton}"
                    Clicked="Btn_OnPassTypesClicked"/>

            <Button Text="Show QR Code"
                    Style="{StaticResource PrimeButton}"
                    Clicked="Btn_OnShowQrCodeClicked"/>

            <Button Text="Log Out" 
                    Style="{StaticResource PrimeButton}"
                    Clicked="Btn_OnLogOutClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
