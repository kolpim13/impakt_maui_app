<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="impakt_maui_app.Pages.Profile.Page_ProfileMember"
             Background="{StaticResource PrimeWhite}"
             Title="Profile">
    
    <VerticalStackLayout Style="{StaticResource PrimeVerticalStack}">
        <Button Text="Show QR Code"
                Style="{StaticResource PrimeButton}"
                Clicked="Btn_OnShowQrCodeClicked"/>

        <Button Text="Log Out" 
                Style="{StaticResource PrimeButton}"
                Clicked="Btn_OnLogOutClicked"/>
    </VerticalStackLayout>
</ContentPage>