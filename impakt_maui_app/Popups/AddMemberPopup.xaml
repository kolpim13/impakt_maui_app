<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="impakt_maui_app.Popups.NewMemberPopup">

    <VerticalStackLayout Padding="20" Spacing="10">
        <!--Fileds should filled-->
        <Entry x:Name="NameEntry" Placeholder="Name" />
        <Entry x:Name="SurnameEntry" Placeholder="Surname" />
        <Entry x:Name="EmailEntry" Placeholder="Email" />
        

        <!--Fields can be left empty-->
        <Button x:Name="ButtonAddMember" Text="Register" Clicked="OnAddMemberlicked" IsEnabled="True"/>
    </VerticalStackLayout>
</toolkit:Popup>
    