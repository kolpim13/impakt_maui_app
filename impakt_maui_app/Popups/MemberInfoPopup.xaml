<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="impakt_maui_app.Popups.MemberInfoPopup">

	<ContentPage.Resources>
		<!-- 1) Define two styles -->
		<Style x:Key="StaticLabelStyle" TargetType="Label">
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="TextColor" Value="Gray" />
			<Setter Property="FontSize" Value="Medium" />
			<Setter Property="VerticalTextAlignment" Value="Center" />
			<Setter Property="HorizontalTextAlignment" Value="End" />
		</Style>

		<Style x:Key="DynamicLabelStyle" TargetType="Label">
			<Setter Property="FontAttributes" Value="None" />
			<Setter Property="TextColor" Value="Black" />
			<Setter Property="FontSize" Value="Medium" />
			<Setter Property="VerticalTextAlignment" Value="Center" />
			<Setter Property="HorizontalTextAlignment" Value="Start" />
			<!-- subtle background for emphasis -->
			<Setter Property="BackgroundColor" Value="#F5F5F5" />
			<Setter Property="Padding" Value="4,2" />
		</Style>
	</ContentPage.Resources>
	
    <VerticalStackLayout Padding="20" Spacing="10">
		<Label Text="Name:"
			   Style="{StaticResource StaticLabelStyle}"/>
        <Label x:Name="LB_Name"
			   Style="{StaticResource DynamicLabelStyle}"/>

		<Label Text="Surname"/>
        <Label x:Name="LB_Surname"/>

		<Label Text="Pass type"/>
		<Label x:Name="LB_PassType"/>
		
		<Label Text="Entrances left"/>
		<Label x:Name="LB_EntrancesLeft"/>
		
		<Label Text="Pass expiration date"/>
		<Label x:Name="LB_PassExpirationDate"/>
    </VerticalStackLayout>
    
</toolkit:Popup>