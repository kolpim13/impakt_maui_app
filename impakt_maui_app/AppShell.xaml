<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="impakt_maui_app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:impakt_maui_app"
    Title="impakt_maui_app">

    <!--Start page ==> Login-->
    <ShellContent
        Title="Login Page"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />
    
    <!--Main page-->
    <ShellContent
        Title="Main Page"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
    <!--Scanner page ==> different mode of scanning-->
    <ShellContent
        Title="QR Scanner"
        ContentTemplate="{DataTemplate local:QRScanner}"
        Route="QRScanner" />
    
    <!--Look on history of checkin-->
    <ShellContent 
        Title="CheckIn History"
        ContentTemplate="{DataTemplate local:CheckinHistory}"
        Route="ChecInHistory"/>

</Shell>
