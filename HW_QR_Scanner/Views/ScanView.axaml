<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HW_QR_Scanner.ViewModels"
             x:DataType="vm:ScanViewModel"
             x:Class="HW_QR_Scanner.Views.ScanView">
  
    <Design.DataContext>
        <vm:ScanViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="*">

        <!--Main Scanner View-->
		<Border Grid.Row="0" Grid.Column="0"
                Padding="8"
                CornerRadius="4">
            <TextBlock Text="Scan mode"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="Bold" />
        </Border>

        <Border Grid.Row="1" Grid.Column="0">
            <TextBlock Text="What is going on?"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold" />
        </Border>

        <!--Full screen overlay-->
        <Grid Grid.Row="0" Grid.Column="0"
              Grid.RowSpan="2" Grid.ColumnSpan="1"
              IsVisible="{Binding IsOverlayVisible}"
              Background="{Binding OverlayColor}"
              Tapped="OnOverlayTapped"
              Opacity="1">

            <TextBlock Text="{Binding OverlayText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       Padding="20" /> 
        </Grid>
    </Grid>
</UserControl>
