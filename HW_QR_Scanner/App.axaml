<Application xmlns="https://github.com/avaloniaui"
             xmlns:local="using:HW_QR_Scanner"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HW_QR_Scanner.Views"
             xmlns:vm="clr-namespace:HW_QR_Scanner.ViewModels"
             x:Class="HW_QR_Scanner.App">

    <TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon>
				<TrayIcon.Menu>
                    <NativeMenu>
						<NativeMenuItem Header="Setting">
						
                        </NativeMenuItem>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
             
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:RegistrationViewModel}">
			<views:RegistrationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainViewModel}">
			<views:MainView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
			<views:ScanView />
        </DataTemplate>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>